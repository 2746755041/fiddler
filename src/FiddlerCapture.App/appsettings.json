{
  "FiddlerCapture": {
    "StartOnApplicationStart": false,
    "ListenPort": 8877,
    "RegisterAsSystemProxy": true,
    "AllowRemoteClients": false,
    "DecryptHttps": false,
    "TrustRootCertificate": false,
    "TrustRootCertificateAsAdmin": false,
    "EnableHttp2": false,
    "DecodeCompressedResponses": true,
    "IncludeBodies": true,
    "MaxCachedSessions": 500,
    "MaxBodyPreviewChars": 4096
  }
}
